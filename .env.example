# Copy this file to .env for local development and fill in real values.
# On Render, set these as Environment Variables in the dashboard instead —
# never commit an actual .env file to GitHub.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Master key for the personal data encrypted with the Modified Blowfish
# algorithm (names, addresses, contact numbers, report and concern text).
# REQUIRED — the app won't read or write that data without it. Generate one:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Use a DIFFERENT key on Render than locally, and keep a backup of the live
# one somewhere other than the database: if it's lost, the encrypted data
# can't be recovered, and changing it makes existing data unreadable.
DATA_ENCRYPTION_KEY=
# PBKDF2 rounds per encrypted value (default 1000). Only affects new values.
# MODIFIED_BLOWFISH_ITERATIONS=1000

# Leave unset locally to use sqlite automatically. On Render, this is
# provided for you when you attach a PostgreSQL database.
#
# If you'd rather develop against a local PostgreSQL install (e.g. so you
# can browse it in pgAdmin, or to match the live environment more closely),
# set it to something like:
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/orms_local
# Special characters in the password (@, #, /, etc.) need to be URL-encoded.
DATABASE_URL=

# Where uploaded images (voter's ID, evidence photos) are stored. Leave
# blank locally — files just go to the local media/ folder. On Render, set
# this to your Cloudinary URL (Dashboard → API Keys), format:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Without it, uploads on Render are lost on every redeploy/restart.
CLOUDINARY_URL=

CORS_ALLOWED_ORIGINS=

# Brevo's SMTP relay, for the emails the system sends (forgot password code,
# account approved/rejected, report/suggestion submitted, report resolved,
# staff/admin notifications). Leave all 3 blank locally to just print emails
# to the console instead of actually sending them.
#   EMAIL_HOST_USER=<your Brevo account's SMTP login, from SMTP & API -> SMTP>
#   EMAIL_HOST_PASSWORD=<an SMTP key generated on that same page — NOT your Brevo account password>
#   DEFAULT_FROM_EMAIL=<the sender address you verified in Brevo>
# See README for the full setup steps.
#
# On Render specifically: if emails aren't going out (or worse, requests that
# should trigger one are erroring/timing out), Render is very likely blocking
# outbound SMTP on the standard port 587. Brevo supports 2525 as an
# alternate submission port for exactly this situation — set this env var
# there too:
#   EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
